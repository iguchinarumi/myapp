<h1>ログイン</h1>                                                                                                         
                                                                                
  <% if flash[:alert] %>                  
    <div style="color: red;">                        
      <%= flash[:alert] %>                    
    </div>                                
  <% end %>                              
                                                                                                                            
  <%= form_with url: login_path do |form| %>
    <div>                                                                                                                   
      <%= form.label :email, "メールアドレス" %><br>                            
      <%= form.email_field :email %>      
    </div>                                
                                                                                                                            
    <div>                        
      <%= form.label :password, "パスワード" %><br>                                                                         
      <%= form.password_field :password %>                                      
    </div>                                
                            
    <div>                                                                                                                   
      <%= form.submit "ログイン" %>           
    </div>                                                                                                                  
  <% end %>       
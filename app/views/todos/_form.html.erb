<%= form_with model: @todo do |form| %>
<% if @todo.errors.any? %>                                                  
      <div style="color: red;">                                                                        
        <h2><%= @todo.errors.count %>件のエラーがあります:</h2>
        <ul>                                                                                           
          <% @todo.errors.full_messages.each do |msg| %>                        
            <li><%= msg %></li>                                                                        
          <% end %>                       
        </ul>                                                                                          
      </div>                                                                                           
    <% end %>                     
    
  <div>
    <%= form.label :title, "タイトル" %><br>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :completed, "完了済み" %>
    <%= form.check_box :completed %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

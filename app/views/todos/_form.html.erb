<%= form_with model: @todo, class: "form" do |form| %>
  <% if @todo.errors.any? %>
    <div class="form__errors">
      <h2 class="form__errors-title"><%= @todo.errors.count %>件のエラーがあります</h2>
      <ul class="form__errors-list">
        <% @todo.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form__group">
    <%= form.label :title, "タイトル", class: "form__label" %>
    <%= form.text_field :title, class: "form__input" %>
  </div>

  <div class="form__group form__group--inline">
    <%= form.check_box :completed, class: "form__checkbox" %>
    <%= form.label :completed, "完了済み", class: "form__label form__label--inline" %>
  </div>

  <div class="form__actions">
    <%= form.submit class: "button button--primary" %>
  </div>
<% end %>

<div class="form-card">
  <div class="page-header">
    <h1 class="page-header__title">ユーザー登録</h1>
  </div>

  <%= form_with model: @user, class: "form" do |form| %>
    <% if @user.errors.any? %>
      <div class="form__errors">
        <h2 class="form__errors-title"><%= @user.errors.count %>件のエラーがあります</h2>
        <ul class="form__errors-list">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form__group">
      <%= form.label :name, "名前", class: "form__label" %>
      <%= form.text_field :name, class: "form__input" %>
    </div>

    <div class="form__group">
      <%= form.label :email, "メールアドレス", class: "form__label" %>
      <%= form.email_field :email, class: "form__input" %>
    </div>

    <div class="form__group">
      <%= form.label :password, "パスワード", class: "form__label" %>
      <%= form.password_field :password, class: "form__input" %>
    </div>

    <div class="form__group">
      <%= form.label :password_confirmation, "パスワード（確認）", class: "form__label" %>
      <%= form.password_field :password_confirmation, class: "form__input" %>
    </div>

    <div class="form__actions">
      <%= form.submit "登録", class: "button button--primary" %>
    </div>
  <% end %>

  <p class="form-card__footer">
    既にアカウントをお持ちですか？
    <%= link_to "ログイン", login_path %>
  </p>
</div>
